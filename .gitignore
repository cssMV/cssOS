node_modules
dist
dist-web
build
.DS_Store

# Claude Code local state
.claude/

# Xcode user-specific build state
**/xcuserdata/
**/*.xcuserstate
DerivedData/
.env
.env.local

# CSSOS_WAVE_171 — App Store Connect API key (.p8) + other local secrets.
# NEVER commit. Re-issuance requires revoking the live key on App Store
# Connect (only one chance to download the .p8 per generation).
secure/
*.p8
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
node_modules/

public/fonts/
public/examples/
public/assets/examples/
artifacts/zh-probe/
public/ops/zh-probe-latest.json
.runs/
artifacts/
remote-rust-api/
registry/target/
rust-api/target/
public/*.bak.*
public/ts-node-dev-hook-*
public/ts-node-dev-ready-*
public/cloud-sql-proxy

# Rust build artifacts (workspace root + cached builds)
target/

# Training datasets — generated/derived, not source-of-truth
data/

# Temp / scratch — never commit
tmp/
tmp_audio/
tmp_inspect/
tmp_scene_runs/
tmp_*.json
tmp_*.sql
tmp_*.js

# Generated outputs (renderer dumps, latents, scene PNGs/MP4s)
output/
rust-api/output/

# Generated reports / scans
file_tree.txt
scan-loginCopy-*.json
scan-loginCopy-*.txt

# Backups + stale vendored snapshot
backups/
repo/

# Commercial Chinese fonts — requires explicit license to redistribute
# (filename suffixes "(商用需授权)" / "(commercial use needs authorization)")
public/fonts_cn2/

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# ── 媒体排除(W1078 Jing: 只 commit 代码)──────────────────
# 音视频:一律不进 git(由 R2/CDN/工作树承载,可再生)
*.mp4
*.mov
*.mp3
*.wav
*.m4a
# 图片:全局不进 git(封面/缩略/兜底/截图/模板封面等,均为媒体)
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
screenshots-appstore/
*-shots/
# 例外:原生 App 构建必需图标/启动图(visionOS + iOS)→ 保留在 git
!visionos/**/*.png
!visionos/**/*.jpg
!ios/**/*.png
!ios/**/*.jpg
