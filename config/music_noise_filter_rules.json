{
  "schema": "css.music_noise_filter_rules.v1",
  "description": "Noise and artifact patterns that should be filtered out before melody-model training.",
  "hard_reject_patterns": [
    "siren",
    "警笛",
    "alarm",
    "警报",
    "buzzer",
    "buzz",
    "电流",
    "electric hum",
    "hum",
    "mains hum",
    "50hz hum",
    "60hz hum",
    "ground loop",
    "hiss",
    "white noise",
    "static noise",
    "radio noise",
    "digital glitch",
    "zipper noise",
    "crackle",
    "click pop",
    "pop noise",
    "clipping",
    "distortion burst",
    "feedback squeal",
    "ringing artifact"
  ],
  "soft_penalty_patterns": [
    "rumble",
    "低频轰鸣",
    "muddy",
    "boxy",
    "harsh sibilance",
    "齿音过重",
    "phase issue",
    "phasey",
    "pumping",
    "breathing artifact",
    "codec smear",
    "warble",
    "flutter",
    "metallic resonance",
    "resonant whistle",
    "whistle tone",
    "detuned",
    "pitch drift",
    "tempo drift",
    "timing drift",
    "out of tune",
    "atonal noise"
  ],
  "must_filter_noise_classes": [
    "警笛式扫频",
    "电流声/嗡声",
    "数字毛刺/zipper noise",
    "爆音/clipping",
    "高频白噪/hiss",
    "低频轰鸣/rumble",
    "过度 pumping/breathing",
    "相位打架/phase issues",
    "节拍漂移",
    "旋律跑调",
    "hook 不可复现"
  ]
}
