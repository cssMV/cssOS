      <!-- CSSOS_PERSON_MV_HOME_SHELVES 20260508 — Jing
           Discovery shelves moved OUT of #logo-panel into a body-level
           container so they don't squish the fixed-width logo panel.
           Renders BELOW the logo-panel (or above foryou-panel). Each shelf
           hides itself when its API returns nothing, so empty rows = no
           visual cost. Style: full viewport width, horizontal scroll inside
           each shelf row. -->
      <!-- CSSOS_WAVE_108 20260509 — Jing
           The 5-shelf stack is replaced by the compact activity bar
           (#cssos-activity-bar) and schools row (#cssos-schools-row),
           both injected into <body> by app.home-activity-bar.js.
           Container kept (display:none) so the shelf modules can
           still mount their data layer, in case a deep link or
           future feature needs them. -->
      <div id="cssos-home-shelves" class="cssos-home-shelves" data-wave108-hidden="1" style="position:relative; z-index:1; padding:0 12px; margin:16px auto; max-width:min(100vw,1280px); display:none; flex-direction:column; gap:8px;">
        <section class="cssos-festival-shelf" id="person-mv-festival-shelf" data-shelf="person-mv-festival" hidden></section>
