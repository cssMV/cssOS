      <section class="panel flow hidden" id="settings-panel">
        <div class="panel-bar">
          <div class="panel-icon">⚙</div>
          <div class="panel-title" data-i18n="panel.settings">Advanced Settings</div>
          <div class="panel-actions cssmv-pill-bar">
            <button class="icon-btn" data-i18n-aria="action.settings" aria-label="Settings">⚙</button>
            <button class="icon-btn" data-i18n-aria="action.minimize" aria-label="Minimize">—</button>
            <button class="icon-btn" data-i18n-aria="action.lock" aria-label="Lock panel">⛶</button>
            <button class="icon-btn" data-i18n-aria="action.close" aria-label="Close">×</button>
          </div>
        </div>
        <div class="panel-body settings-body">
          <label>
            <span data-i18n="settings.titleOrPrompt">Title / Prompt</span>
            <!-- v28 step 34 — Jing: align with MV PIPELINE panel. Accept
                 either a finished title OR a free-form theme/prompt;
                 backend extracts the title. textarea (rows=3) so user
                 has room to write a sentence, not just a few words.
                 placeholder is dynamically populated by
                 app.civilization-ui-hints.js from the UI locale's
                 civilization titleHints. -->
            <textarea
              id="title-input"
              rows="3"
              placeholder=""
            ></textarea>
          </label>
          <!-- CSSOS_WAVE_415 20260524 — Jing「放自定义歌词上方」: multilingual
               picker mount point (Advanced Settings). Mounted by app.creation-flow
               with freeFirst=true; its selection persists as the canonical
               language preference read by every entry (incl. zero-input 一键MV). -->
          <div id="creation-language-picker"></div>
          <label class="field-shell field-shell-rich">
            <span class="field-label-row">
              <span data-i18n="settings.customLyrics">Custom Lyrics</span>
              <!-- CSSOS_PHASE2_DUAL_WAND 20260429 #192/#195 — Jing
                   两个魔法棒。
                   🪄 (lyrics-regenerate, this row, right side):
                       generate title + lyrics + ALL params from scratch
                       using UI language + civilization linkage.
                   🪄 (style-regenerate, on Music Style row below):
                       reused as "derive params only from existing
                       title+lyrics" — see CSSOS_deriveParamsFromLyrics.
                       The wand image stays the same; the handler now
                       routes based on whether lyrics are present.
                   -->
              <button
                id="lyrics-regenerate"
                class="field-action-btn"
                type="button"
                data-i18n-aria="action.regenerateLyrics"
                aria-label="Regenerate title + lyrics + all params (civilization-linked)"
                title="新随机一首：标题+歌词+所有参数"
                onpointerdown="return window.CSSOS_forceLyricsRegenerate ? window.CSSOS_forceLyricsRegenerate(event) : true;"
              >
                🪄
              </button>
            </span>
            <div class="seed-script-tabs lyrics-input-tabs scroll-peek" data-scroll-peek>
              <button class="cta ghost tiny active" type="button" data-lyrics-input-tab="editor">Custom Lyrics</button>
              <button class="cta ghost tiny" type="button" data-lyrics-input-tab="uploads">Music Source Uploads</button>
            </div>
            <div class="seed-script-panes lyrics-input-panes">
              <div class="seed-script-pane active" id="lyrics-input-pane-editor">
                <textarea
                  id="lyrics-input"
                  rows="6"
                  placeholder="Drop your own verses or a full opera..."
                  data-i18n-placeholder="settings.lyricsPlaceholder"
                ></textarea>
                <div id="lyrics-debug-status" class="field-debug-status" aria-live="polite" data-i18n="settings.lyricsDebugIdle" hidden>
                  Click the wand to view lyric generation status.
                </div>
              </div>
              <div class="seed-script-pane lyrics-input-upload-pane" id="lyrics-input-pane-uploads">
                <div id="lyrics-music-upload-tab-root"></div>
              </div>
            </div>
          </label>
          <div class="row row-single">
            <label>
              <span data-i18n="settings.voiceGender">Voice Gender</span>
              <!-- CSSOS_PHASE2_NO_HARDCODED_VOICE_DEFAULT 20260427 #162 — Jing
                   "Feminine"是硬编码默认；改成 "Auto" 让 derived_settings 在
                   lyrics 阶段按文明 × 歌词代词智能填充，用户没显式选择前
                   一律走 auto 路径。空 value 让前端跳过提交而 derived_settings
                   能补齐。 -->
              <select id="voice-input">
                <option value="" selected data-i18n="creation.option.vocalGender.auto">Auto · 文明智能填充</option>
                <option value="feminine" data-i18n="creation.option.vocalGender.feminine">Feminine</option>
                <option value="masculine" data-i18n="creation.option.vocalGender.masculine">Masculine</option>
                <option value="childlike" data-i18n="creation.option.vocalGender.childlike">Childlike</option>
                <option value="duet" data-i18n="creation.option.vocalGender.duet">Duet</option>
                <option value="androgynous" data-i18n="creation.option.vocalGender.androgynous">Androgynous</option>
                <option value="polyphonic_choir" data-i18n="creation.option.vocalGender.polyphonic_choir">Polyphonic Choir</option>
              </select>
            </label>
          </div>
          <label>
            <span data-i18n="settings.sources">Sources / Story Links</span>
            <textarea
              id="lyrics-source-input"
              rows="3"
              placeholder="Related references / source pages / story links..."
              data-i18n-placeholder="settings.sourcesPlaceholder"
            ></textarea>
          </label>
          <div class="seed-script-panel">
            <div class="seed-script-tabs scroll-peek" data-scroll-peek>
              <button class="cta ghost tiny active" type="button" id="seed-tab-music" data-seed-tab="music" data-i18n="settings.musicStructure">Music Structure</button>
              <button class="cta ghost tiny" type="button" id="seed-tab-outline" data-seed-tab="outline" data-i18n="settings.videoOutline">Video Outline</button>
              <button class="cta ghost tiny" type="button" id="seed-tab-scenes" data-seed-tab="scenes" data-i18n="settings.sectionPrompts">Section Scene Prompts</button>
            </div>
            <div class="seed-script-panes">
              <div class="seed-script-pane active" id="seed-pane-music">
                <div class="field-label-row seed-pane-label-row">
                  <span data-i18n="settings.musicStructure">Music Structure</span>
                  <button
                    id="music-structure-regenerate"
                    class="field-action-btn"
                    type="button"
                    data-i18n-aria="action.regenerateMusicStructure"
                    aria-label="Regenerate music structure"
                  >
                    🪄
                  </button>
                </div>
                <textarea
                  id="music-structure-input"
                  rows="7"
                  placeholder="Section-by-section beat map and arrangement arc..."
                  data-i18n-placeholder="settings.musicStructurePlaceholder"
                ></textarea>
              </div>
              <div class="seed-script-pane" id="seed-pane-outline">
                <div class="field-label-row seed-pane-label-row">
                  <span data-i18n="settings.videoOutline">Video Outline</span>
                  <button
                    id="video-outline-regenerate"
                    class="field-action-btn"
                    type="button"
                    data-i18n-aria="action.regenerateVideoOutline"
                    aria-label="Regenerate video outline"
                  >
                    🪄
                  </button>
                </div>
                <textarea
                  id="video-outline-input"
                  rows="6"
                  placeholder="Overall MV visual outline..."
                  data-i18n-placeholder="settings.videoOutlinePlaceholder"
                ></textarea>
              </div>
              <div class="seed-script-pane" id="seed-pane-scenes">
                <div class="field-label-row seed-pane-label-row">
                  <span data-i18n="settings.sectionPrompts">Section Scene Prompts</span>
                  <button
                    id="section-prompts-regenerate"
                    class="field-action-btn"
                    type="button"
                    data-i18n-aria="action.regenerateSectionPrompts"
                    aria-label="Regenerate section prompts"
                  >
                    🪄
                  </button>
                </div>
                <textarea
                  id="section-prompts-input"
                  rows="10"
                  placeholder="One section prompt per section..."
                  data-i18n-placeholder="settings.sectionPromptsPlaceholder"
                ></textarea>
              </div>
            </div>
          </div>
          <div class="creation-console" id="creation-console">
            <div class="creation-tabs scroll-peek" id="creation-tabs" data-scroll-peek></div>
            <div class="creation-chips scroll-peek" id="creation-chips" data-scroll-peek></div>
            <label class="field-shell creation-style-shell">
              <span class="field-label-row">
                <span data-i18n="settings.musicStyle">Music Style</span>
                <!-- CSSOS_PHASE2_DUAL_WAND 20260429 #192/#195 — Jing
                     This is the SECOND wand. Originally a Music Style-only
                     regenerator; repurposed to "derive ALL other params
                     from existing title + lyrics" (BPM/key/voice gender/
                     vocal style/instrumentation/ensemble/percussion/
                     arrangement density/dynamics/articulation/register/
                     section form/inspiration/...). Civilization-anchored
                     by UI language. The first wand (above, in CUSTOM
                     LYRICS row) regenerates title+lyrics+everything from
                     scratch; this one preserves the user's title+lyrics
                     and only fills the other knobs. -->
                <button
                  id="style-regenerate"
                  class="field-action-btn"
                  type="button"
                  data-i18n-aria="action.deriveParamsFromLyrics"
                  aria-label="Derive params only from current title + lyrics (civilization-linked)"
                  title="保留歌词，只随机其他参数（BPM/调式/声线/乐器/编制…）"
                  onpointerdown="return window.CSSOS_deriveParamsFromLyrics ? window.CSSOS_deriveParamsFromLyrics(event) : true;"
                >
                  🪄
                </button>
              </span>
              <textarea
                id="style-input"
                rows="3"
                maxlength="2000"
                placeholder=""
                data-i18n-placeholder="settings.musicStylePlaceholder"
              ></textarea>
            </label>
            <div class="creation-meta">
              <span id="creation-style-count">0/2000</span>
            </div>
            <div class="row">
              <label>
                <span data-i18n="settings.tempoBpm">Tempo (BPM)</span>
                <input id="creation-tempo" type="number" min="40" max="220" step="1" placeholder="—" />
              </label>
              <label>
                <span data-i18n="settings.key">Key</span>
                <!-- CSSOS_PHASE2_NO_HARDCODED_KEY_DEFAULT 20260427 #162 — Jing
                     Hardcoded "C" first-option was the implicit default;
                     replaced with empty "Auto" so derived_settings drives the
                     final key based on civilization × language × mood. -->
                <select id="creation-key">
                  <option value="" selected data-i18n="creation.option.key.auto">Auto · 智能填充</option>
                  <option value="C">C</option>
                  <option value="D">D</option>
                  <option value="E">E</option>
                  <option value="F">F</option>
                  <option value="G">G</option>
                  <option value="A">A</option>
                  <option value="B">B</option>
                </select>
              </label>
            </div>
            <div class="row">
              <label>
                <span data-i18n="settings.durationSec">Duration (sec)</span>
                <!-- CSSOS_PHASE2_NO_HARDCODED_180 20260427 #162 — Jing:
                     "DURATION (SEC)（不要默认180秒，反人类反音乐的）" —
                     placeholder shows "auto · 文明智能" so user knows the
                     lyrics engine will derive the real duration. -->
                <input id="creation-duration" type="number" min="30" max="600" step="5" data-i18n-placeholder="settings.durationPlaceholder" placeholder="auto" />
              </label>
            </div>
            <!-- CSSOS_WAVE_431 20260525 — Jing: #creation-language dropdown removed;
                 language is controlled exclusively by #creation-language-picker above.
                 Keeping a hidden stub so legacy JS reads don't throw on getElementById. -->
            <select id="creation-language" hidden aria-hidden="true"></select>
            <div class="row">
              <label>
                <span>Work Type</span>
                <!-- CSSOS_PHASE2_NO_HARDCODED_WORK_TYPE 20260427 #162 — Jing
                     "Single" was first-option default; let lyrics-stage
                     derived_settings infer (single / triptych / opera /
                     short_drama / series / film) from section-form. -->
                <select id="creation-work-type">
                  <option value="" selected data-i18n="creation.option.workType.auto">Auto · smart-detect</option>
                  <option value="single">Single</option>
                  <option value="triptych">Triptych</option>
                  <option value="opera">Opera</option>
                  <option value="short_drama">Short Drama</option>
                  <option value="series">Series</option>
                  <option value="film">Film</option>
                </select>
              </label>
            </div>
            <div class="row">
              <label>
                <span>Instrumentation</span>
                <input
                  id="creation-instrumentation"
                  type="text"
                  maxlength="400"
                  placeholder="e.g. guzheng, dizi, low strings, taiko, analog bass"
                />
              </label>
              <label>
                <span data-i18n="creation.vocalStyle">Vocal Style</span>
                <input
                  id="creation-vocal-style"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. airy bel canto, chesty soul, close-mic whisper"
                  data-i18n-placeholder="creation.vocalStylePlaceholder"
                />
              </label>
            </div>
            <!-- CSSOS_PHASE2_MAKE_INSTRUMENTAL_TOGGLE 20260429 #188 — Jing
                 "make_instrumental 请在高级设置面板才参数开关,
                  有时候需要生成纯音乐". When checked, the music engine
                 ignores lyrics and generates instrumental-only audio. -->
            <div class="row">
              <label class="row-checkbox">
                <input id="creation-make-instrumental" type="checkbox" />
                <span data-i18n="creation.makeInstrumental">Instrumental only (skip vocals & lyrics)</span>
              </label>
            </div>
            <div class="row">
              <label>
                <span data-i18n="creation.ensembleStyle">Ensemble Style</span>
                <input
                  id="creation-ensemble-style"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. chamber strings, festival drums, synth-pop band"
                  data-i18n-placeholder="creation.ensembleStylePlaceholder"
                />
              </label>
              <label>
                <span data-i18n="creation.licensedStylePack">Licensed Style Pack</span>
                <input
                  id="creation-licensed-style-pack"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. orchestra.core.v1"
                  data-i18n-placeholder="creation.licensedStylePackPlaceholder"
                />
              </label>
            </div>
            <div class="row">
              <label>
                <span data-i18n="creation.externalAudioAdapter">External Audio Adapter</span>
                <input
                  id="creation-external-audio-adapter"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. kontakt, spitfire, eastwest, custom://orchestra"
                  data-i18n-placeholder="creation.externalAudioAdapterPlaceholder"
                />
              </label>
            </div>
            <div class="row">
              <label>
                <span data-i18n="creation.arrangementDensity">Arrangement Density</span>
                <input
                  id="creation-arrangement-density"
                  type="range"
                  min="0.2"
                  max="1"
                  step="0.05"
                  value="0.6"
                />
              </label>
              <label>
                <span data-i18n="creation.dynamicsCurve">Dynamics Curve</span>
                <input
                  id="creation-dynamics-curve"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. rising arc, soft verse / explosive chorus"
                  data-i18n-placeholder="creation.dynamicsCurvePlaceholder"
                />
              </label>
            </div>
            <div class="row">
              <label>
                <span data-i18n="creation.sectionForm">Section Form</span>
                <input
                  id="creation-section-form"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. intro, verse, pre-chorus, chorus, bridge, chorus, outro"
                  data-i18n-placeholder="creation.sectionFormPlaceholder"
                />
              </label>
              <label>
                <span data-i18n="creation.articulationBias">Articulation Bias</span>
                <input
                  id="creation-articulation-bias"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. legato lead, staccato pulse, pizzicato bridge"
                  data-i18n-placeholder="creation.articulationBiasPlaceholder"
                />
              </label>
            </div>
            <div class="row">
              <label>
                <span data-i18n="creation.voicingRegister">Voicing Register</span>
                <input
                  id="creation-voicing-register"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. low cinematic bed, mid vocal pocket, bright high lead"
                  data-i18n-placeholder="creation.voicingRegisterPlaceholder"
                />
              </label>
              <label>
                <span data-i18n="creation.percussionActivity">Percussion Activity</span>
                <input
                  id="creation-percussion-activity"
                  type="range"
                  min="0"
                  max="1"
                  step="0.05"
                  value="0.45"
                />
              </label>
            </div>
            <div class="row">
              <label>
                <span>Expression CC Bias</span>
                <input
                  id="creation-expression-cc-bias"
                  type="text"
                  maxlength="240"
                  placeholder="e.g. swell into chorus, breathing verse, restrained intro"
                />
              </label>
              <label>
                <span>Humanization</span>
                <input
                  id="creation-humanization"
                  type="range"
                  min="0"
                  max="1"
                  step="0.05"
                  value="0.35"
                />
              </label>
            </div>
            <label class="field-shell">
              <span>Inspiration Notes</span>
              <textarea
                id="creation-inspiration-notes"
                rows="3"
                maxlength="1000"
                placeholder="Use high-level references, eras, regions, instrumentation, emotional pacing, and legally licensed packs. Avoid requesting a direct clone of a specific artist or recording."
              ></textarea>
            </label>
            <div class="creation-reference-library">
              <div class="panel-label">Reference Atlas</div>
              <div class="creation-reference-note">
                Use these as broad musical inspirations and ensemble references, not as a request to clone a specific living artist or copyrighted recording.
              </div>
              <div id="creation-reference-library"></div>
            </div>
            <div class="row creation-defaults-row" id="creation-defaults-row" hidden>
              <label>
                <span>Default Listen Price</span>
                <input id="creation-default-listen" type="number" min="0.01" step="0.01" value="0.99" />
              </label>
              <label>
                <span>Default Buyout Price</span>
                <input id="creation-default-buyout" type="number" min="0" step="0.01" value="2.99" />
              </label>
            </div>
            <div class="creation-summary" id="creation-summary"></div>
            <div class="creation-universe-card" id="creation-universe-card"></div>
            <div class="creation-actions">
              <button id="creation-set-defaults" class="cta ghost tiny" type="button" data-i18n="settings.panel.setDefault" hidden>Set as Default</button>
              <button id="creation-clear" class="cta ghost tiny" type="button" data-i18n="action.clearAll">Clear All</button>
            </div>
          </div>
          <div class="palette-color-tabs scroll-peek" id="palette-color-tabs" data-scroll-peek>
            <label class="palette-color-card">
              <span data-color-name-for="bg-color-1">—</span>
              <input id="bg-color-1" type="color" value="#00f5a0" />
            </label>
            <label class="palette-color-card">
              <span data-color-name-for="bg-color-2">—</span>
              <input id="bg-color-2" type="color" value="#040a08" />
            </label>
            <label class="palette-color-card">
              <span data-color-name-for="bg-color-3">—</span>
              <input id="bg-color-3" type="color" value="#008c64" />
            </label>
            <label class="palette-color-card">
              <span data-color-name-for="bg-color-4">—</span>
              <input id="bg-color-4" type="color" value="#010302" />
            </label>
          </div>
          <button
            id="random-palette"
            class="cta ghost"
            type="button"
            data-i18n="action.randomPalette"
          >
            Random Palette
          </button>
          <div class="palette-presets scroll-peek" role="tablist" aria-label="Palette presets" data-scroll-peek>
            <button class="cta ghost tiny" type="button" data-palette-preset="mono-green" data-i18n="settings.palettePreset.green">Emerald</button>
            <button class="cta ghost tiny" type="button" data-palette-preset="mono-red" data-i18n="settings.palettePreset.red">Crimson</button>
            <button class="cta ghost tiny" type="button" data-palette-preset="mono-blue" data-i18n="settings.palettePreset.blue">Azure</button>
            <button class="cta ghost tiny" type="button" data-palette-preset="mono-purple" data-i18n="settings.palettePreset.purple">Violet</button>
            <button class="cta ghost tiny" type="button" data-palette-preset="mono-gold" data-i18n="settings.palettePreset.gold">Gold</button>
          </div>
          <button id="apply-settings" class="cta" data-i18n="action.applyRender">
            Apply & Render
          </button>
          <button id="advanced-panel-settings-toggle" class="cta ghost tiny" type="button" data-i18n="settings.panel.advancedHub">Advanced Panel Settings</button>
          <div class="advanced-panel-settings" id="advanced-panel-settings"></div>
        </div>
        <div class="resize-handle"></div>
      </section>

      <section class="panel flow hidden" id="language-panel">
        <div class="panel-bar">
          <div class="panel-icon">🌐</div>
          <div class="panel-title" data-i18n="panel.language">Language</div>
          <div class="panel-actions cssmv-pill-bar">
            <button class="icon-btn" aria-label="settings">⚙</button>
            <button class="icon-btn" aria-label="minimize">—</button>
            <button class="icon-btn" aria-label="maximize">⤢</button>
            <button class="icon-btn" aria-label="close">×</button>
          </div>
        </div>
        <div class="panel-body language-body">
          <div class="panel-label" data-i18n="language.subtitle">Interface Language</div>
          <div class="language-current" id="language-current"></div>
          <div class="language-grid" id="language-list"></div>
          <button class="cta ghost tiny" id="language-more" type="button">
            <span class="lang-more-ico">🌐</span><span class="lang-more-txt">Add language</span>
          </button>
          <div class="language-grid is-hidden" id="language-list-more"></div>
          <div class="language-status" id="language-status" data-i18n="language.ready">
            Ready
          </div>
        </div>
        <div class="resize-handle"></div>
      </section>

      <section class="panel flow hidden" id="login-panel">
        <div class="panel-bar">
          <div class="panel-icon">🔐</div>
          <div class="panel-title" data-i18n="panel.login">Login</div>
          <div class="panel-actions cssmv-pill-bar">
            <button class="icon-btn" type="button" data-i18n-aria="action.settings" aria-label="settings">⚙</button>
            <button class="icon-btn" aria-label="minimize">—</button>
            <button class="icon-btn" aria-label="maximize">⤢</button>
            <button class="icon-btn" aria-label="close">×</button>
          </div>
        </div>
        <div class="panel-body login-body">
          <div class="panel-label" data-i18n="login.subtitle">
            Social Login Gateways
          </div>
          <div class="login-status" id="login-status" data-i18n="login.statusGuest">
            Guest
          </div>
          <div class="login-user" id="login-user"></div>
          <div id="login-summary-host"></div>
          <div class="login-grid cssmv-pill-bar" id="login-list"></div>
          <!-- CSSOS_WAVE_878 — Jing「回滚到干净的全宽 Apple, 撤掉 W875 那段说明文字」。全宽机制(solo 类 + 内联钉死)保留。 -->
          <button class="cta ghost tiny" id="login-logout" type="button" data-i18n="login.logout">
            Log out
          </button>
        </div>
        <div class="resize-handle"></div>
      </section>

      <section class="panel flow hidden" id="profile-panel">
        <div class="panel-bar">
          <div class="panel-icon">👤</div>
          <div class="panel-title" data-i18n="profile.title">Profile</div>
          <div class="panel-actions cssmv-pill-bar">
            <!-- CSSOS_PHASE2_PROFILE_CHROME 20260505 — Jing
                 "profile面板，应该做成普通面板，右上角三按钮，最大化
                  状态启动". Standard three-button cluster, matching
                 every other panel. -->
            <button class="icon-btn" type="button" data-i18n-aria="action.minimize" aria-label="Minimize">—</button>
            <button class="icon-btn" type="button" data-i18n-aria="action.lock" aria-label="Lock panel">⛶</button>
            <button class="icon-btn" type="button" data-action="profile.close" data-i18n-aria="action.close" aria-label="Close">×</button>
          </div>
        </div>
        <div class="panel-body">
          <div class="profile-grid">
            <div class="profile-row">
              <div class="profile-label" data-i18n="profile.passkey">Passkey</div>
              <div class="profile-actions" data-segmented="2" data-pill-bar>
                <button class="cta tiny" id="passkey-enable" type="button" data-action="passkey.enable" data-i18n="profile.passkeyEnable">Enable</button>
                <button class="cta tiny" id="passkey-login" type="button" data-action="passkey.login" data-i18n="profile.passkeyLogin">Login</button>
              </div>
            </div>
            <div class="profile-hint" id="profile-hint"></div>
          </div>
          <!-- CSSOS_PHASE2_PERSONALIZATION_INBOX 20260502 #271 — Jing.
               cssOS · Curator drops every system gift MV here. Mounted by
               public/app.gift-inbox-panel.js when the user signs in. -->
          <div id="gift-inbox-mount" class="gift-inbox-mount"></div>
        </div>
      </section>

      <section class="panel flow hidden" id="notifications-panel">
        <div class="panel-bar">
          <div class="panel-icon">🔔</div>
          <div class="panel-title" data-i18n="panel.notifications">Notifications</div>
          <div class="panel-actions cssmv-pill-bar">
            <button class="icon-btn" aria-label="settings">⚙</button>
            <button class="icon-btn" aria-label="minimize">—</button>
            <button class="icon-btn" aria-label="maximize">⤢</button>
