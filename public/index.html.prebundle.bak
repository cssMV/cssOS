         nav, dead-anchor reloads, double-tap fires. Must load early so
         CSS rules apply before any panel renders. -->
    <script src="app.touch-hardening.js?v=20260530-w536-quiet"></script>
    <!-- CSSOS_WAVE_192 — on first user gesture, request true fullscreen
         on the document so iOS hides the top time bar + auto-hides the
