<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- CSSOS_WAVE_518 20260530 — bootprobe 诊断探针已移除(崩溃排查完成, 不留在生产)。 -->
    <!-- CSSOS_WAVE_460 20260527 — Jing: WKWebView ignores HTTP Cache-Control: no-store
         for in-memory cache. HTML meta http-equiv tags are always honoured by WebKit.
         These three lines force fresh HTML + asset fetches on every load, eliminating
         the "old CSS on refresh" flip-flop seen in the iOS Capacitor app. -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <!-- CSSOS_WAVE_284 20260521 — Jing: 标记 App/standalone 上下文 → <html.cssos-app>.
         App 端(Capacitor iOS UA=cssos-ios / PWA standalone / iOS 主屏 standalone)据此
         隐藏 watch 标题栏并让媒体框充满全屏; 桌面浏览器不加此 class, 维持原样.
         必须最早执行(在 CSS 应用前打上 class, 避免布局闪)。 -->
    <script>
      (function () {
        try {
          var ua = String(navigator.userAgent || "").toLowerCase();
          var isApp = /cssos-ios/.test(ua)
            || (window.matchMedia && window.matchMedia("(display-mode: standalone)").matches)
            || navigator.standalone === true;
          if (isApp) document.documentElement.classList.add("cssos-app");
        } catch (e) {}
      })();
    </script>
    <!-- CSSOS_PHASE2_TRUE_FULLSCREEN 20260505 — Jing
         "手机端的MV面板能否让面板真全屏充满手机屏幕". viewport-fit=cover
         lets the page extend UNDER the notch + home-indicator. The
         apple-mobile-web-app-capable meta lets users "Add to Home
         Screen" for genuine standalone (iOS hides its own chrome
         entirely). theme-color=black blends Safari's UI with our
         cinema canvas during normal browsing. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <!-- CSSOS_WAVE_437 — standard meta (Chrome deprecated the apple- prefix). -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#000000" />
    <!-- CSSOS_PERSON_MV_WAVE32 20260508 — Jing: PWA manifest, maskable icons, SW registration. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <base href="/" />
    <title>CSS Studio — Watch + create AI music videos, instantly</title>
    <!-- CSSOS_WAVE_721 — 产品/公司描述(供搜索引擎、社交分享、以及审核员识别"这家公司做什么产品")。 -->
    <meta name="description" content="CSS Studio is the first zero-friction watch + create platform for AI music videos. Open the app and a fully-produced music video plays, with sound, instantly — then create your own, in any language and any voice, without ever leaving the cinema. Featuring the world's first emotion subtitles." />
    <meta name="keywords" content="AI music video, AI MV, music video generator, watch and create, AI music, emotion subtitles, multilingual music video, CSS Studio" />
    <meta name="author" content="CSS Studio" />
    <link rel="canonical" href="https://cssstudio.app/" />
    <meta property="og:site_name" content="CSS Studio" />
    <meta property="og:title" content="CSS Studio — Watch + create AI music videos, instantly" />
    <meta property="og:description" content="Open the app and a fully-produced AI music video plays with sound, the moment it loads. Then create your own — any language, any voice — without leaving the cinema. The world's first emotion subtitles." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cssstudio.app/" />
    <meta property="og:image" content="https://cssstudio.app/icons/icon-512.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="CSS Studio — Watch + create AI music videos" />
    <meta name="twitter:description" content="A fully-produced AI music video plays the moment you open the app, with sound. Then create your own in any language and voice." />
    <meta name="twitter:image" content="https://cssstudio.app/icons/icon-512.png" />
    <script>
      // Pre-paint theme resolver — applies user's saved theme BEFORE any CSS loads
      // to prevent flash-of-unstyled-theme (FOUT). Must stay in sync with
      // PANEL_BEHAVIOR_SETTINGS_KEY / appearance.theme_mode in app.panel-behavior-core.js.
      (function () {
        try {
          var raw = localStorage.getItem("cssos.panelBehaviorSettings") || "{}";
          var parsed = {};
          try { parsed = JSON.parse(raw) || {}; } catch (_) { parsed = {}; }
          var mode = (parsed && parsed.appearance && parsed.appearance.theme_mode) || "system";
          if (mode !== "system" && mode !== "dark" && mode !== "light") mode = "system";
          var eff = mode;
          if (mode === "system") {
            try {
              eff = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light";
            } catch (_) { eff = "dark"; }
          }
          var el = document.documentElement;
          el.dataset.theme = eff;
          el.dataset.themeMode = mode;
          el.dataset.themeIcon = eff === "dark" ? "☾" : "☀";
          el.style.colorScheme = eff;
          // Also propagate to body as soon as it exists (some CSS keys off body[data-theme]).
          var applyToBody = function () {
            if (!document.body) return;
            document.body.dataset.theme = eff;
            document.body.dataset.themeMode = mode;
          };
          if (document.body) {
            applyToBody();
          } else if (document.addEventListener) {
            document.addEventListener("DOMContentLoaded", applyToBody, { once: true });
          }
        } catch (_) {
          // swallow — defaults take over
        }
      })();
    </script>
    <link rel="stylesheet" href="style.css?v=20260531-w587b-cap" />
    <!-- CSSOS_WAVE_588 线4 — 极简未来感视觉内核: 设计令牌 + 复用表面/对话框/空态。 -->
    <link rel="stylesheet" href="app.core-ui.css?v=20260602-w588r-core" />
    <!-- CSSOS_WAVE_714 — 真凶: style.watch.css(承载全部字幕/卡拉OK/情绪爆样式, 38 条 .watch-karaoke-word
         规则)此前【从未被任何页面加载】→ 字幕词无颜色规则、继承父淡绿白 = Jing 的"还绿"; 随机色/稳定/
         中央爆/[Music...] 一整轮 CSS 全部失效。在 style.css 之后加载它, 让 watch 面板按设计生效。 -->
    <link rel="stylesheet" href="style.watch.css?v=20260621-w1094-scroll" />
    <!-- CSSOS_WAVE_525 — style.mv-pipeline.css 已移除: 改由 cssosLoadPanel("mv-pipeline") 启动面板时动态注入(见 app.panel-manifest.js CSSOS_PANEL_CSS). -->

  </head>
  <body>
    <!-- CSSOS_WAVE_491 20260529 — Jing「启动: 魔镜 logo 接力到主界面, 中间不要黑屏」.
         原生闪屏 launchShowDuration=1200ms 后固定消失, 但此时网页主界面常还没渲染好 →
         露出黑色 WKWebView 空档。这个网页端启动遮罩用【同一个魔镜 logo】从首帧就盖住屏幕,
         与原生闪屏无缝衔接; 主界面就绪后(或兜底超时)淡出 → 直接显示主界面, 全程无黑屏。
         内联样式 + 内联脚本: 不依赖 style.css / app.js, 首字节即生效, 即使主程序崩溃/慢加载
         也照常显示 logo。背景跟随系统深/浅色, 与主界面 --bg 对齐, 淡出不跳色。 -->
    <div id="cssos-launch-splash" aria-hidden="true">
      <img src="assets/mirror-1.webp" alt="" decoding="async" />
    </div>
    <style>
      #cssos-launch-splash{position:fixed;inset:0;z-index:2147483600;display:flex;
        align-items:center;justify-content:center;background:#020302;
        transition:opacity .42s ease;opacity:1;}
      #cssos-launch-splash img{width:42vw;max-width:170px;height:auto;
        animation:cssosSplashBreath 2.4s ease-in-out infinite;
        filter:drop-shadow(0 6px 28px rgba(0,245,160,0.28));}
      @keyframes cssosSplashBreath{0%,100%{transform:scale(0.965);opacity:.82}
        50%{transform:scale(1.035);opacity:1}}
      /* CSSOS_WAVE_1224 — splash 底色跟【用户选的主题】(pre-paint 已把 data-theme 写到 <html>),
         不再只跟系统暗色。白天用户即使设备是暗色, splash 也是奶油底, 不会先黑一下。 */
      html[data-theme="light"] #cssos-launch-splash{background:#f6efe4;}
      html[data-theme="dark"] #cssos-launch-splash{background:#020302;}
      @media (prefers-color-scheme: light){html:not([data-theme]) #cssos-launch-splash{background:#f6efe4;}}
      #cssos-launch-splash.cssos-splash-hide{opacity:0;pointer-events:none;}
    </style>
    <script>
      (function(){
        var s=document.getElementById("cssos-launch-splash");
        if(!s)return;
        // CSSOS_WAVE_1207 — Jing「为什么换一个一样的 logo、跳一下」根因: 网页(Safari/桌面)没有 WKWebView 黑屏空档,
        //   静态 HTML 的大厅魔镜从首帧就在; splash 盖上去再淡出 = 两套 logo 交接"跳一下换 logo"。
        //   → 网页端【根本不显示 splash】, 只剩大厅一个 logo, 呼吸 + 口号淡入, 无交接无跳变。
        //   仅【原生 App(Capacitor)】保留 splash 兜原生闪屏后的黑屏空档。
        var _native=!!(window.Capacitor && (typeof window.Capacitor.isNativePlatform!=="function" || window.Capacitor.isNativePlatform()));
        if(!_native){ try{ s.parentNode&&s.parentNode.removeChild(s); }catch(_e){} return; }
        var done=false,start=Date.now();
        function hide(){if(done)return;done=true;
          s.classList.add("cssos-splash-hide");
          setTimeout(function(){try{s.parentNode&&s.parentNode.removeChild(s);}catch(_e){}},480);}
        // 主界面就绪信号: 模块初始化完成会派发 cssos:ready(若有); 否则用 DOM 就绪 + 帧。
        function ready(){
          // 至少撑到原生闪屏消失后(~1300ms), 避免"网页先于原生闪屏淡出"再露黑。
          var wait=Math.max(0,1300-(Date.now()-start));
          setTimeout(hide,wait);
        }
        try{document.addEventListener("cssos:ready",hide,{once:true});}catch(_e){}
        if(document.readyState==="interactive"||document.readyState==="complete"){
          requestAnimationFrame(function(){requestAnimationFrame(ready);});
        }else{
          document.addEventListener("DOMContentLoaded",function(){
            requestAnimationFrame(function(){requestAnimationFrame(ready);});
          });
        }
        // 兜底: 无论如何 6s 后必淡出, 绝不把用户钉在 logo 上。
        setTimeout(hide,6000);
      })();
    </script>
