      <section class="panel flow hidden" id="cssmv-panel">
        <div class="panel-bar">
          <div class="panel-icon">🎬</div>
          <div class="panel-title" data-i18n="panel.cssmv">CSS MV</div>
          <div class="panel-actions cssmv-pill-bar">
            <button class="icon-btn" aria-label="settings">⚙</button>
            <button class="icon-btn" aria-label="minimize">—</button>
            <button class="icon-btn" aria-label="maximize">⤢</button>
            <button class="icon-btn" aria-label="close">×</button>
          </div>
        </div>
        <div class="panel-body">
          <div class="panel-label" data-i18n="label.autoWatch">Auto Watch Pipeline</div>
          <section class="mv-digest-pulse" id="mv-digest-pulse">
            <div class="mv-pulse-header">
              <div>
                <div class="mv-pulse-kicker" data-i18n="cssmv.digest.kicker">Delivery Digest</div>
                <div class="mv-pulse-title" data-i18n="cssmv.digest.title">Daily delivery snapshot for dashboard and ops review</div>
              </div>
              <div class="mv-pulse-version" id="mv-digest-status" data-i18n="cssmv.digest.waitingStatus">Waiting for delivery digest.</div>
            </div>
            <div class="mv-workspace-strip">
              <div class="mv-workspace-title" id="mv-digest-title" data-i18n="cssmv.digest.waitingTitle">Waiting for daily delivery digest</div>
              <div class="mv-workspace-summary" id="mv-digest-summary" data-i18n="cssmv.digest.waitingSummary">Open CSS MV to load the latest delivery dashboard summary.</div>
            </div>
            <div class="mv-digest-metrics" id="mv-digest-metrics">
              <div class="mv-digest-metric is-waiting">
                <span data-i18n="cssmv.digest.metrics.escalated">Escalated</span>
                <strong>--</strong>
              </div>
              <div class="mv-digest-metric is-waiting">
                <span data-i18n="cssmv.digest.metrics.manualIntervention">Manual</span>
                <strong>--</strong>
              </div>
              <div class="mv-digest-metric is-waiting">
                <span data-i18n="cssmv.digest.metrics.retry">Retry</span>
                <strong>--</strong>
              </div>
              <div class="mv-digest-metric is-waiting">
                <span data-i18n="cssmv.digest.metrics.resolutionChange">Resolution</span>
                <strong>--</strong>
              </div>
            </div>
            <div class="mv-pulse-grid mv-digest-grid">
              <div class="mv-pulse-card">
                <div class="mv-pulse-label" data-i18n="cssmv.digest.queueTitle">Queue Counts</div>
                <div class="mv-digest-queue-list" id="mv-digest-inbox-counts">
                  <button class="mv-digest-queue is-waiting" type="button">
                    <span data-i18n="cssmv.digest.waitingQueue">Waiting for queue counts.</span>
                  </button>
                </div>
                <div class="mv-digest-preview" id="mv-digest-preview">
                  <div class="mv-digest-preview-empty" data-i18n="cssmv.digest.waitingPreview">Select a queue to inspect live preview items.</div>
                </div>
              </div>
              <div class="mv-pulse-card">
                <div class="mv-pulse-label" data-i18n="cssmv.digest.alertTitle">Alert Headlines</div>
                <div class="mv-digest-alert-list" id="mv-digest-alerts">
                  <div class="mv-digest-alert is-waiting">
                    <span class="mv-digest-alert-copy" data-i18n="cssmv.digest.waitingAlerts">Waiting for alert headlines.</span>
                  </div>
                </div>
              </div>
              <div class="mv-pulse-card">
                <div class="mv-pulse-label" data-i18n="cssmv.digest.highlightTitle">Highlights</div>
                <ul class="mv-pulse-list" id="mv-digest-highlights">
                  <li data-i18n="cssmv.digest.waitingHighlights">Waiting for digest highlights.</li>
                </ul>
              </div>
            </div>
          </section>
          <div class="mv-hero">
            <div>
              <!-- CSSMV_CIV_UI_HINTS 20260424 #94 — Jing: static demo title
                   "嫦娥奔月" removed; app.civilization-ui-hints.js fills this
                   from the current UI locale's civilization titleHints. -->
              <div class="mv-title" id="mv-title"></div>
              <div class="mv-sub" id="mv-sub" data-i18n="label.mvSub">
                3 Scene · 12 Shots · Live Karaoke
              </div>
            </div>
            <button class="cta tiny" id="enter-watch" data-i18n="action.enterWatch">
              Enter Watch
            </button>
          </div>
          <div class="tag-row" id="mv-tags"></div>
          <div class="stat-grid" id="mv-stats"></div>
          <section class="mv-governance-pulse" id="mv-governance-pulse">
            <div class="mv-pulse-header">
              <div>
                <div class="mv-pulse-kicker" data-i18n="cssmv.governance.kicker">Delivery Governance Pulse</div>
                <div class="mv-pulse-title" data-i18n="cssmv.governance.title">Inspector visibility wired to live backend payloads</div>
              </div>
              <div class="mv-pulse-version" id="mv-policy-version" data-i18n="cssmv.governance.waitingPolicyVersion">Waiting for live policy version</div>
            </div>
            <div class="mv-workspace-strip">
              <div class="mv-workspace-title" id="mv-workspace-title" data-i18n="cssmv.workspace.waitingTitle">Waiting for live delivery workspace</div>
              <div class="mv-workspace-summary" id="mv-workspace-summary" data-i18n="cssmv.workspace.waitingSummary">Waiting for live delivery workspace summary.</div>
            </div>
            <div class="mv-actions-strip">
              <div class="mv-pulse-label" data-i18n="cssmv.actions.title">Available Actions</div>
              <div class="mv-actions-list" id="mv-actions-list">
                <span class="mv-action-chip is-waiting" data-i18n="cssmv.actions.waiting">Waiting for live delivery actions.</span>
              </div>
            </div>
            <div class="mv-actions-strip">
              <div class="mv-pulse-label" data-i18n="cssmv.actionLog.title">Recent Action Log</div>
              <div class="mv-action-log-list" id="mv-action-log-list">
                <div class="mv-action-log-item is-waiting" data-i18n="cssmv.actionLog.waiting">Waiting for live delivery action logs.</div>
              </div>
            </div>
            <div class="mv-trust-strip">
              <div class="mv-trust-badge" id="mv-trust-badge" data-i18n="cssmv.governance.waitingTrustBadge">Trust waiting</div>
              <div class="mv-trust-summary" id="mv-trust-summary" data-i18n="cssmv.governance.waitingTrustState">Waiting for live delivery trust state.</div>
            </div>
            <div class="mv-risk-strip">
              <div class="mv-risk-badge" id="mv-risk-badge" data-i18n="cssmv.governance.waitingRiskBadge">Risk waiting</div>
              <div class="mv-risk-summary" id="mv-risk-summary" data-i18n="cssmv.governance.waitingRiskState">Waiting for live delivery risk state.</div>
            </div>
            <div class="mv-assurance-strip">
