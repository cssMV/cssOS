    <!-- CSSOS_PHASE2_PANEL_3BTN_BULLETPROOF 20260505b — Jing
         Self-diagnosing version. Stamps the document so you can verify
         from console that this script actually ran. On every click on a
         panel-actions button it also flashes a small badge in the
         top-right corner so you can see WITHOUT devtools whether the
         click was intercepted. Runs at window-capture (earlier than any
         document-level handler) with stopImmediatePropagation so nothing
         else can preempt. Calls top-level globals from app.js. -->
    <script>
      (function () {
        // Self-stamp: from devtools console run
        //   document.documentElement.dataset.panel3btn
        // → should print "armed-842d260b" if this script ran.
        document.documentElement.dataset.panel3btn = "armed-842d260b";

        // Debug flash badge — only enabled if localStorage.cssos_debug_3btn = "1".
        // (Hidden by default now that user has confirmed buttons work.)
        var DEBUG_3BTN = false;
        try { DEBUG_3BTN = localStorage.getItem("cssos_debug_3btn") === "1"; } catch (_e) {}
        function flash(msg) {
          if (!DEBUG_3BTN) return;
          var b = document.getElementById("panel-3btn-debug-badge");
          if (!b) {
            b = document.createElement("div");
            b.id = "panel-3btn-debug-badge";
            b.style.cssText =
              "position:fixed;top:8px;right:8px;z-index:2147483647;" +
              "padding:6px 10px;border-radius:8px;font:600 11px/1 ui-monospace,monospace;" +
              "background:rgba(0,245,160,0.95);color:#001b14;pointer-events:none;" +
              "box-shadow:0 4px 14px rgba(0,0,0,0.4);transition:opacity .25s;opacity:0;";
            document.body.appendChild(b);
          }
          b.textContent = msg;
          b.style.opacity = "1";
          clearTimeout(flash._t);
          flash._t = setTimeout(function () { b.style.opacity = "0"; }, 1500);
        }

        function classify(btn) {
          var raw = ((btn.dataset && btn.dataset.action) || btn.getAttribute("aria-label") || btn.getAttribute("data-i18n-aria") || btn.textContent || "").trim().toLowerCase();
          if (raw.indexOf("setting") >= 0) return "settings";
          if (raw === "—" || raw.indexOf("minimize") >= 0 || raw.indexOf("min") === 0) return "minimize";
          if (raw === "⤢" || raw === "⛶" || raw.indexOf("maximize") >= 0 || raw.indexOf("max") >= 0 || raw.indexOf("lock") >= 0 || raw.indexOf("full") >= 0 || raw.indexOf("expand") >= 0) return "maximize";
          if (raw === "×" || raw === "x" || raw.indexOf("close") >= 0) return "close";
          return "";
        }

        // Window-level capture — fires before any document/element handler.
        // pointerdown gives us first crack; we still also handle click so
        // text-only browsers / synthetic events work.
        function handle(event) {
          var t = event.target;
          if (!(t instanceof Element)) return;
          var btn = t.closest(".panel-actions .icon-btn");
          if (!btn) return;
          var panel = btn.closest(".panel");
          if (!panel) return;
          var kind = classify(btn);
          if (!kind) return;
          flash("3btn FIRE: " + kind + " (" + (panel.id || "panel") + ")");
          event.preventDefault();
          event.stopPropagation();
          if (event.stopImmediatePropagation) event.stopImmediatePropagation();
          // Only act on click, not pointerdown (pointerdown is reserved
          // so the drag handler doesn't grab the button).
          if (event.type !== "click") return;
          try { if (typeof focusPanel === "function") focusPanel(panel); } catch (_e) {}
          var isMv = panel.id === "watch-panel";
          try {
            if (isMv) {
              // CSSOS_MV_PANEL_3BTN 20260505 — Jing
              // MV panel buttons get cinema-aware behavior:
              //   minimize → toggle .mv-body-collapsed (hide media frame, pause)
              //   maximize → exit cinema fullscreen → user's manual size
              //   close    → exit cinema + clear media + minimize to dock
              if (kind === "minimize") {
                var collapsed = panel.classList.toggle("mv-body-collapsed");
                var v = document.getElementById("watch-video");
                var a = document.getElementById("watch-audio-preview");
                try {
                  if (collapsed) { v && v.pause && v.pause(); a && a.pause && a.pause(); }
                  else { v && v.play && v.play().catch(function () {}); a && a.play && a.play().catch(function () {}); }
                } catch (_e) {}
                return;
              }
              if (kind === "maximize") {
                /* CSSOS_MV_MAXIMIZE_TOGGLE 20260505 — Jing
                 * "面板右上角的最大化按钮（无法再进入影院模式，甚至无法再
                 *  进入MV面板，请修复）"
                 * Old behavior: only exited cinema. Clicking once when out
                 * of cinema did nothing. Now a true toggle. */
                var isInCinema = panel.classList.contains("is-cssmv-fullscreen") ||
                                 document.body.classList.contains("cssos-cinema-mode");
                if (isInCinema) {
                  // EXIT path
                  try { if (document.fullscreenElement) document.exitFullscreen(); } catch (_e) {}
                  panel.classList.remove("is-cssmv-fullscreen");
                  document.body.classList.remove("cssos-cinema-mode", "cssos-watch-theater", "cssos-watch-idle");
                  if (typeof restorePanel === "function" && panel.dataset.maximized === "true") {
                    try { restorePanel(panel); } catch (_e) {}
                  }
                } else {
                  // ENTER path — full cinema with browser fullscreen.
                  if (panel.classList.contains("hidden")) panel.classList.remove("hidden");
                  panel.dataset.minimized = "false";
                  try {
                    if (typeof globalThis.cssosEnterCinemaLayout === "function") {
                      globalThis.cssosEnterCinemaLayout();
                    } else {
                      panel.classList.add("is-cssmv-fullscreen");
                      document.body.classList.add("cssos-cinema-mode");
                    }
                  } catch (_e) {}
                  try {
                    if (typeof globalThis.cssosRequestBrowserFullscreen === "function") {
                      globalThis.cssosRequestBrowserFullscreen();
                    }
                  } catch (_e) {}
                }
                return;
              }
              if (kind === "close") {
                // Pure-cinema cleanup: exit fullscreen, drop classes, stop media,
                // then hand off to the regular minimize-to-dock flow.
                try { if (document.fullscreenElement) document.exitFullscreen(); } catch (_e) {}
                panel.classList.remove("is-cssmv-fullscreen", "mv-body-collapsed");
                document.body.classList.remove("cssos-cinema-mode", "cssos-watch-theater", "cssos-watch-idle");
                try {
                  var vv = document.getElementById("watch-video");
                  var aa = document.getElementById("watch-audio-preview");
                  if (vv) { vv.pause(); vv.removeAttribute("src"); vv.load && vv.load(); }
                  if (aa) { aa.pause(); aa.removeAttribute("src"); aa.load && aa.load(); }
                } catch (_e) {}
                // CSSOS_WAVE_450: restore background videos freed on MV open
                try {
                  if (typeof globalThis.restoreBgVideosForMvModule === "function") {
                    globalThis.restoreBgVideosForMvModule();
                  }
                } catch (_e) {}
                if (typeof minimizeToDock === "function") minimizeToDock(panel);
                return;
              }
            }
            if (kind === "minimize" && typeof togglePanelCollapse === "function") togglePanelCollapse(panel);
            else if (kind === "maximize" && typeof togglePanelMaximize === "function") togglePanelMaximize(panel);
            else if (kind === "close" && typeof minimizeToDock === "function") minimizeToDock(panel);
            else if (kind === "settings" && typeof togglePanelSettings === "function") togglePanelSettings(panel);
            else flash("3btn STUB: " + kind + " fn missing");
          } catch (err) {
            console.error("[panel-3btn]", kind, err);
            flash("3btn ERROR: " + kind);
          }
        }
        window.addEventListener("pointerdown", handle, true);
        window.addEventListener("click", handle, true);

        /* CSSOS_PURE_CINEMA_IDLE 20260505c — Jing
         * "图1，还是标题栏和右下角信息没有隐藏"
         *
         * Some chrome was leaking through every CSS-based hide attempt
         * because something else was setting opacity/display via inline
         * style or a higher-specificity rule we couldn't pin down. Switch
         * to JS-driven inline-style hiding: when cinema turns on we record
         * each chrome element's original `display` value and force it to
         * `none` via element.style. On exit / wake we restore the original.
         * Inline style beats every CSS rule short of `!important` on the
         * same element — and even `!important` is overridden because we
         * also set the inline style with priority "important".
         *
         * Force-unmute the video on cinema entry too: "有些媒体静音自动
         * 播放，需要用户再动一下". The previous restore-snapshot path was
         * preserving an initial muted=true state, so the user landed in
         * silent autoplay. The MV open click IS user activation, so we
         * can promote video.muted = false synchronously and call play().
         */
        (function () {
          var idleTimer = null;
          // CSSOS_WAVE_296 20260521 — Jing: "10秒，没有特殊强调，都是10秒".
          // Single unified idle window for ALL watch chrome (top trio +
          // bottom dock) so they reveal/hide as ONE unit, never staggered.
          var IDLE_MS = 10000;
          // Selectors to forcibly hide while cinema is on AND user is idle.
          // Subtitle (#watch-subtitle, #watch-karaoke-line, .watch-lyric-line)
          // intentionally NOT in this list — those are part of the cinema
          // experience, not chrome.
          var CHROME_SELECTORS = [
            // CSSOS_WAVE_220C 20260521 — Jing: title bar (.panel-bar) must
            // STAY RESIDENT in cinema. Hiding it on idle made the media
            // frame jump up/down (layout reflow) every wake/idle cycle.
            // Removed from the force-hide list. (.panel-actions buttons
            // below still auto-hide — only the bar shell stays.)
            "#watch-panel .panel-actions",
            "#watch-panel .panel-toolbar",
            "#watch-panel .watch-toolbar",
            "#watch-panel #watch-pill-row-bl",
            "#watch-panel #watch-pill-row-br",
            "#watch-panel #watch-aspect-pill",
            "#watch-panel #watch-take-toggle",
            "#watch-panel #watch-immersive-pill",
            "#watch-panel #watch-author-avatar",
            "#watch-panel .watch-author-avatar",
            "#watch-panel .watch-media-action",
            "#watch-panel .watch-style-shift",
            // Right-bottom corner cluster (♪ ✦ i ⛶) — same fade as the
            // title bar and left subtitle so chrome hides as one unit.
            // Per Jing 2026-05-05: 彩虹条 (.cssmv-border-bar) and 进度条
            // (.panel-progress-line) are intentionally NOT hidden — they
            // are part of the cinema viewing experience.
            "#watch-panel .cssmv-fr-btn",
            "#watch-panel .cssmv-info-btn",
            "#watch-panel .cssmv-fs-btn",
            "#watch-panel .cssmv-stem-toggle",
            // CSSOS_WAVE_296/311 — top floating search box + exit-cinema ✕ join
            // the SAME hide unit as the dock so the top row (avatar/search/✕)
            // and bottom dock show/hide TOGETHER, step-consistent (Jing: 步调
            // 一致 — 不能一个显一个不显).
            "#watch-search-box",
            "#watch-exit-cinema",
            "#dock"
            // CSSOS_WAVE_647 20260605 — Jing「情绪字幕(熟歌词)10 秒后被隐藏」终极根因:
            // W356 当初把 #watch-karaoke-line / #watch-subtitle 加进了这个【影院 10s 空闲
            // 强制 display:none !important】列表, 与其它 chrome 步调一致地隐藏。但情绪字幕是
            // 演出的一部分, 必须【逐字唱到段落结束】(W640/W644/W646 同一铁律)。这条硬 display:none
            // 凌驾于一切 opacity 豁免与内容写入之上 —— 这才是"前 10 秒能看见、一沉浸就消失"的真凶。
            // 把字幕/karaoke 行【移出隐藏列表】, 让它在影院里常驻。其余 chrome 仍 10s 隐藏。
          ];
          var hidden = []; // [{el, prevDisplay, prevPriority}]
          function inCinema() {
            return document.body && document.body.classList.contains("cssos-cinema-mode");
          }
          function hideChrome() {
            if (!inCinema()) return;
            CHROME_SELECTORS.forEach(function (sel) {
              document.querySelectorAll(sel).forEach(function (el) {
                if (el.dataset.cssosCinemaHidden === "1") return;
                hidden.push({ el: el, prev: el.style.display, prevPriority: el.style.getPropertyPriority("display") });
                el.dataset.cssosCinemaHidden = "1";
                el.style.setProperty("display", "none", "important");
              });
            });
            document.body.style.setProperty("cursor", "none", "important");
          }
          function showChrome() {
            hidden.forEach(function (rec) {
              try {
                rec.el.dataset.cssosCinemaHidden = "";
                if (rec.prev) rec.el.style.setProperty("display", rec.prev, rec.prevPriority || "");
                else rec.el.style.removeProperty("display");
              } catch (_e) {}
            });
            hidden = [];
            document.body.style.removeProperty("cursor");
          }
          function sleep() {
            if (!inCinema()) return;
            // CSSOS_WAVE_296 — don't hide mid-search: if the floating search
            // input is focused or has text, re-arm instead of hiding so the
            // user can keep reading results.
            try {
              var si = document.getElementById("watch-search-input");
              if (si && (document.activeElement === si || String(si.value || "").trim())) {
                if (idleTimer) clearTimeout(idleTimer);
                idleTimer = setTimeout(sleep, IDLE_MS);
                return;
              }
            } catch (_e) {}
            hideChrome();
          }
          function wake() {
            if (!inCinema()) {
              showChrome();
              if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
              return;
            }
            showChrome();
            /* W335 20260522 — first user gesture in cinema → try to unblock
             * audio. iOS Safari blocks autoplay on load; this is the earliest
             * moment we have a real user-gesture context to call play(). */
            forceUnmuteAndPlay();
            if (idleTimer) clearTimeout(idleTimer);
            idleTimer = setTimeout(sleep, IDLE_MS);
          }
          ["pointermove","pointerdown","wheel","keydown","touchstart"].forEach(function (ev) {
            window.addEventListener(ev, wake, { capture: true, passive: true });
          });
          /* CSSOS_WAVE_392 20260524 — Jing「多首歌同时播放, 一片交响乐」根治:
           * 单一可闻音源裁判。#watch-audio-preview 是【有声那条】(canonical 音轨),
           * #watch-video 是【画面】。之前 forceUnmuteAndPlay 把【两条都 unmute 并
           * play】→ 视频自带音轨 + 预览 mp3(再加队列切歌竞态/看门狗重启的残留元素)
           * 叠在一起 = 交响乐。现在: 任一时刻【只有一条可闻】—— 有 audio-preview
           * 有 src 就以它为音源(视频静音播放只做画面); 否则视频出声。 */
          function cssosPickSoundEl() {
            var v = document.getElementById("watch-video");
            var a = document.getElementById("watch-audio-preview");
            var aHasSrc = a && String(a.currentSrc || a.src || "").trim();
            return aHasSrc ? a : v;
          }
          function cssosEnforceSingleAudio() {
            // CSSOS_WAVE_407 20260524 — Jing「断断续续, 每隔几秒静音」根治: 此前本
            // 裁判在【每个 play 事件】上对 video+audio-preview 重设 .muted, 和
            // app.watch-ui(W406: video.muted=hasAudioElSrc)互相抢 → 周期性静音/恢复、
            // 歌词被跳过。现在: 当前作品的 canonical 对(video + audio-preview)的静音
            // 状态【完全交给 watch-ui】, 本裁判只负责【静音并暂停杂散元素】
            // (mic-capture / foryou-thumb / mirror / 重复元素), 绝不碰那一对。
            try {
              var v = document.getElementById("watch-video");
              document.querySelectorAll("audio, video").forEach(function (el) {
                if (el === v || el.id === "watch-audio-preview") return; // owned by watch-ui
                try {
                  el.muted = true;
                  el.setAttribute("muted", "");
                  if (!el.paused) el.pause();
                } catch (_e) {}
              });
            } catch (_e) {}
          }
          // Global referee: whenever ANY media starts, collapse back to one
          // audible source — kills overlaps from queue races / duplicate plays.
          try {
            document.addEventListener("play", function () {
              setTimeout(cssosEnforceSingleAudio, 0);
            }, true);
          } catch (_e) {}
          globalThis.cssosEnforceSingleAudio = cssosEnforceSingleAudio;

          // CSSOS_WAVE_406 20260524 — removed the duplicate W396 "🔊 Tap for sound"
          // pill (#cssos-sound-hint): app.watch-ui.js already ships #watch-sound-hint
          // ("🔇 Tap for sound") via showWatchSoundHintModule(), so the page was
          // showing TWO hints at once (Jing: "两个 Tap for sound, 一个红色的"). Keep
          // the single existing one.

          function forceUnmuteAndPlay() {
            // CSSOS_WAVE_407 20260524 — Jing「断断续续」根治: 简化为【一次性】解锁声音
            // + 起播, 不再在每个 canplay/loadeddata 上反复重设 .muted(那是周期性静音的
            // 元凶之一)。静音状态归 watch-ui(W406)管: 它已把视频静音、把 <audio> 设为
            // 唯一音源。这里只在手势/解锁时确保【音源不静音】并 play(); 杂散元素交给裁判。
            try {
              var v = document.getElementById("watch-video");
              var a = document.getElementById("watch-audio-preview");
              var sound = cssosPickSoundEl();
              if (sound) {
                try { sound.muted = false; sound.removeAttribute("muted"); sound.volume = 1; } catch (_e) {}
              }
              [v, a].forEach(function (el) {
                if (!el || !el.play) return;
                el.play().catch(function () {
                  // Desktop blocks UNMUTED autoplay → fall back to muted so the
                  // picture still plays; sound resumes on the next gesture / hint.
                  try { el.muted = true; if (el.play) el.play().catch(function () {}); } catch (_e2) {}
                });
              });
              cssosEnforceSingleAudio(); // silence/pause only stray elements
            } catch (_e) {}
          }
          /* CSSOS_WAVE_374 20260523 — Jing「自动播放别停, 不要让用户点」: build 16 已
           * 允许免手势 play(), 但没有"卡住自动续播"的看门狗 —— iOS/缓冲一旦把媒体
           * 暂停, 在下次手势前没人重启它, 用户就得点一下才继续(进度条才走). 这里给
           * 有声那条(#watch-audio-preview)+ 视频装一个看门狗: 只要 watch 面板还开着、
           * 媒体没播完、有 src, pause/stalled/waiting/suspend 时就自动 play() 续上。
           * 限速 900ms 防抖, 不和"播完→队列连播"打架(ended 不重启)。 */
          function installAutoplayWatchdogOnce() {
            ["watch-audio-preview", "watch-video"].forEach(function (id) {
              var el = document.getElementById(id);
              if (!el || el.dataset.cssosWatchdog) return;
              el.dataset.cssosWatchdog = "1";
              var lastReplay = 0;
              function watchOpen() {
                var wp = document.getElementById("watch-panel");
                return wp && !wp.classList.contains("hidden") &&
                  getComputedStyle(wp).display !== "none";
              }
              function resume() {
                try {
                  if (!watchOpen()) return;
                  if (el.ended) return;
                  if (!String(el.currentSrc || el.src || "").trim()) return;
                  var now = Date.now();
                  if (now - lastReplay < 900) return;
                  lastReplay = now;
                  if (el.play) el.play().catch(function () {});
                  // CSSOS_WAVE_398 — after resuming, re-assert the single-audio
                  // rule so a watchdog-resumed element can't become a 2nd voice.
                  try { cssosEnforceSingleAudio(); } catch (_e) {}
                } catch (_e) {}
              }
              ["pause", "stalled", "waiting", "suspend"].forEach(function (ev) {
                el.addEventListener(ev, function () { setTimeout(resume, 120); }, { passive: true });
              });
              /* CSSOS_WAVE_379 20260523 — Jing「自动播又不动了」根因不是 CSS, 是这支
               * 作品的音频是过期第三方链接(Mubert 死得最快)→ 404 → play() 永远失败,
               * 看门狗 re-play 一个 404 = 死循环卡住。对【有声那条】加 error 处理:
               * 音频 404/解码失败 → 自动【跳下一首】(死链作品自动跳过), autoplay 永不卡死。
               * 计数上限 8, 防全库死链时无限跳。 */
              if (id === "watch-audio-preview") {
                el.addEventListener("error", function () {
                  try {
                    if (!watchOpen()) return;
                    window.__cssosAudioSkips = (window.__cssosAudioSkips || 0) + 1;
                    if (window.__cssosAudioSkips > 8) return;
                    var now = Date.now();
                    if (now - lastReplay < 1200) return;
                    lastReplay = now;
                    if (typeof globalThis.cssosWatchQueueAdvance === "function") {
                      globalThis.cssosWatchQueueAdvance(1);
                    }
                  } catch (_e) {}
                }, { passive: true });
              }
            });
          }
          try { installAutoplayWatchdogOnce(); } catch (_e) {}
          var observer = new MutationObserver(function () {
            try { installAutoplayWatchdogOnce(); } catch (_e) {}
            if (inCinema()) {
              forceUnmuteAndPlay();
              sleep();
            } else {
              showChrome();
              if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
            }
          });
          observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });

          /* CSSOS_AUTO_RE_ENTER_CINEMA 20260505 — Jing
           * "退出影院模式之后，再次进入，影院模式丢失了". Watch every
           * transition of #watch-panel from .hidden to visible and re-fire
           * cssosEnterCinemaLayout so cinema is the default on every open,
           * regardless of which open path the user took (logo / mic / play
           * / right-click / Apply&Render / dock click / restored session). */
          (function () {
            var wp = document.getElementById("watch-panel");
            if (!wp) {
              // watch-panel may not exist yet on early DOMContentLoaded.
              document.addEventListener("DOMContentLoaded", arguments.callee);
              return;
            }
            var wasHidden = wp.classList.contains("hidden");
            new MutationObserver(function () {
              var nowHidden = wp.classList.contains("hidden");
              if (wasHidden && !nowHidden) {
                // Panel just opened — force cinema, force-unmute, force-play.
                try { if (typeof globalThis.cssosEnterCinemaLayout === "function") globalThis.cssosEnterCinemaLayout(); } catch (_e) {}
                setTimeout(forceUnmuteAndPlay, 100);
                setTimeout(forceUnmuteAndPlay, 600);
              }
              wasHidden = nowHidden;
            }).observe(wp, { attributes: true, attributeFilter: ["class"] });
          })();

          if (inCinema()) sleep();
        })();
      })();
    </script>
    <style>
      /* CSSOS_PURE_CINEMA_CSS 20260505b — Jing
         "不管主题色是白天还是晚上，进入MV面板欣赏MV，就默认是真全屏影院模式。"
         When cinema is on, force a pure-black canvas regardless of light/dark
         theme, kill ALL panel chrome (border, perimeter rainbow ring, info
         pills), and gate panel-bar/dock visibility behind cssos-watch-idle.
         Idle is added IMMEDIATELY on cinema enter (see script above) so the
         baseline is "hidden chrome, pure media". Activity reveals chrome for
         1.5s. */

      /* Force black everywhere cinema can leak through, regardless of theme. */
      body.cssos-cinema-mode,
      body.cssos-cinema-mode #watch-panel,
      body.cssos-cinema-mode #watch-panel .panel-body,
      body.cssos-cinema-mode #watch-panel .watch-body,
      body.cssos-cinema-mode #watch-panel .watch-pane,
      body.cssos-cinema-mode #watch-panel .watch-pane.active,
      body.cssos-cinema-mode #watch-panel .watch-frame,
      body.cssos-cinema-mode #watch-panel .watch-screen {
        background: #000 !important;
      }

      /* Per Jing 2026-05-05: keep the rainbow perimeter chase ring
         (.cssmv-border-bar) visible — it's part of the cinema viewing
         experience, not chrome to hide. */

      /* Strip the green panel border and any glow shadow. */
      body.cssos-cinema-mode #watch-panel {
        border: none !important;
        outline: none !important;
        box-shadow: none !important;
        border-radius: 0 !important;
      }

      /* Smooth fade for the elements we hide. */
      body.cssos-cinema-mode #watch-panel .panel-bar,
      body.cssos-cinema-mode #dock,
      body.cssos-cinema-mode #toast,
      body.cssos-cinema-mode #panel-3btn-debug-badge,
      body.cssos-cinema-mode #watch-panel .watch-aspect-pill,
      body.cssos-cinema-mode #watch-panel #watch-pill-row-bl,
      body.cssos-cinema-mode #watch-panel #watch-take-toggle,
      body.cssos-cinema-mode #watch-panel .watch-media-action,
      body.cssos-cinema-mode #watch-panel .watch-author-avatar {
        transition: opacity .35s ease;
      }

      /* When idle (default once cinema turns on, until user moves):
         HARD hide chrome with display:none — opacity:0 was being beaten
         by some other rule on the user's screen. Higher-specificity
         multi-anchor selector covers both .panel-bar and .panel-title-bar
         naming conventions, and adds #watch-pill-row-br + immersive pill
         + every standalone watch-* button I could find injected by
         app.watch-ui.js. */
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel .panel-toolbar,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel .panel-actions,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel .watch-toolbar,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel #watch-pill-row-bl,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel #watch-pill-row-br,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel #watch-aspect-pill,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel #watch-take-toggle,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel #watch-immersive-pill,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel #watch-author-avatar,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel .watch-author-avatar,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel .watch-media-action,
      html body.cssos-cinema-mode.cssos-watch-idle #watch-panel .watch-style-shift,
      html body.cssos-cinema-mode.cssos-watch-idle #dock,
      html body.cssos-cinema-mode.cssos-watch-idle #panel-3btn-debug-badge {
        display: none !important;
      }
      /* (cssmv-border-bar rainbow ring is intentionally preserved in cinema.) */
      /* CSSOS_WAVE_925 20260617 — Jing「播放媒体时, 三件套(字幕/价格条/AI 助理)+ 四边框
         进度条 从开始到结束常驻, 都显示」: 明确豁免, 即使影院 idle(10s 无操作)也绝不隐藏
         这四样。压过上面的 idle 隐藏 + 任何祖先 opacity/visibility 淡出。进度条本就只在 ended
         闪爆后淡出(app.watch-stage-bars.js), 这里不动它的 opacity, 只保证 idle 不藏它。 */
      html body.cssos-cinema-mode.cssos-watch-idle #watch-subtitle,
      html body.cssos-cinema-mode.cssos-watch-idle #cssos-watch-priceline,
      html body.cssos-cinema-mode.cssos-watch-idle #cssos-watch-price-strip,
      html body.cssos-cinema-mode.cssos-watch-idle #cssos-agent-fab,
      html body.cssos-cinema-mode.cssos-watch-idle .cssmv-border-bar.is-active {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
      }
      body.cssos-cinema-mode.cssos-watch-idle {
        cursor: none;
      }

      /* MV panel "minimize" → keep only the panel-bar, hide the body. */
      #watch-panel.mv-body-collapsed .panel-body,
      #watch-panel.mv-body-collapsed .watch-body,
      #watch-panel.mv-body-collapsed .watch-frame,
      #watch-panel.mv-body-collapsed .watch-screen {
        display: none !important;
      }
      #watch-panel.mv-body-collapsed {
        height: auto !important;
        min-height: 0 !important;
      }
    </style>
    <!-- CSSOS_PERSON_MV_WAVE32 20260508 — Jing: register service worker for offline + push. -->
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function (err) {
            console.warn("[sw] register failed:", err && err.message);
          });
        });
      }
    </script>
    <!-- CSSOS_WAVE80 20260508 — Jing: Sentry browser init (server injects
         window.__cssosSentryDsn via SENTRY_DSN_PUBLIC) + web-vitals reporter.
         Both are best-effort; missing DSN is a clean no-op. -->
    <script>
      (function () {
        var dsn = window.__cssosSentryDsn || "";
        if (!dsn) return;
        var s = document.createElement("script");
        s.src = "https://browser.sentry-cdn.com/7.119.0/bundle.min.js";
        s.crossOrigin = "anonymous";
        s.onload = function () {
          try {
            if (window.Sentry && typeof window.Sentry.init === "function") {
              window.Sentry.init({ dsn: dsn, tracesSampleRate: 0.1 });
            }
          } catch (_e) {}
        };
        document.head.appendChild(s);
      })();
    </script>
    <script src="/app.webvitals.js" defer></script>
  </body>
</html>
