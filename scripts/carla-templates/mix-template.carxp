<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE CARLA-PROJECT>
<CARLA-PROJECT VERSION="2.5.9">
  <EngineSettings>
    <ForceStereo>true</ForceStereo>
    <PreferPluginBridges>false</PreferPluginBridges>
    <PreferUiBridges>false</PreferUiBridges>
    <UIsAlwaysOnTop>false</UIsAlwaysOnTop>
    <MaxParameters>200</MaxParameters>
    <UIBridgesTimeout>4000</UIBridgesTimeout>
  </EngineSettings>
  <!--
    CSSMV mix stage template.
    Placeholders expanded by cssmv-carla-render-template.sh:
      {{ARTIFACT_DIR}}
      {{SESSION_DIR}}
      {{INPUT_STEM}}
      {{OUTPUT_MANIFEST}}
      {{OUTPUT_1}}
      {{OUTPUT_BASENAME_1}}
  -->
</CARLA-PROJECT>
