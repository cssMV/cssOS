<?xml version="1.0" encoding="UTF-8"?>
<!-- CSSOS_WAVE_941 — SharePlay 共享圣殿(W939)需要的 Group Activities 能力。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.developer.group-session</key>
    <true/>
    <!-- 原生 Sign in with Apple(Optic ID 表单, 非网页登录) -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
    <!-- CSSOS_WAVE_1066 — Associated Domains: Siri/Universal Link 直达 /auth/return 回跳 +
         webcredentials(Sign in with Apple/密码自动填充)。需 cssstudio.app 部署 AASA
         (/.well-known/apple-app-site-association, 后端已有 W98C AASA 路由)。 -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:cssstudio.app</string>
        <string>webcredentials:cssstudio.app</string>
    </array>
</dict>
</plist>
